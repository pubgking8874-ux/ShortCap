<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Permissions surfaced in Settings → Permissions. Only the declarations
        needed by the Permissions management center are listed; runtime
        requests and the system-settings redirects are driven from
        PermissionActions / PermissionRepository.
    -->
    <!-- Internet access for the website favicon system (FaviconRepository:
         downloads a site's official favicon.ico and caches it locally) and
         for local website-domain verification (DomainVerifier: DNS lookup +
         lightweight HTTPS reachability before a domain can be blocked).
         ACCESS_NETWORK_STATE lets the verifier detect offline mode instantly
         instead of waiting for a DNS timeout. Both are normal permissions,
         granted automatically at install — never requested at runtime. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        Sound Mode → Android device ringer mode (Sound / Vibrate / Silent).
        Changing the ringer via AudioManager.setRingerMode requires this
        manifest permission AND Notification Policy Access granted by the user
        in system settings (checked via isNotificationPolicyAccessGranted).
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Continuous monitoring: a foreground service keeps the monitoring
        process alive after the user leaves ShortsCap or removes it from
        Recents (subject to Android/OEM limits). FOREGROUND_SERVICE is
        install-time granted; FOREGROUND_SERVICE_SPECIAL_USE is required on
        Android 14+ for the specialUse foreground-service type the
        monitoring use case uses. The service starts only after the required
        monitoring permissions (Usage Access + Accessibility) are granted.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!--
        Reading the user's local sound files from Downloads/All sounds
        (Sound & Effects). READ_MEDIA_AUDIO applies to Android 13+;
        READ_EXTERNAL_STORAGE (declared above, maxSdkVersion=32) covers
        Android 12 and below. Requested at runtime from the sound
        configuration screens.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!--
        Known app packages so installed app icons can be resolved via
        PackageManager on Android 11+ (API 30+). When the Accessibility
        service / backend is connected, this list will be replaced by the
        data source and needs no UI changes.
    -->
    <queries>
        <!-- Short Applications discovery (Short Control): every package the
             existing ShortPlatformRegistry recognizes as a supported
             short-form platform, so PackageManager can report whether each
             is installed on Android 11+ (API 30+). Deliberately minimal
             package visibility — no QUERY_ALL_PACKAGES; unknown/random
             installed apps are never queried or listed. -->
        <package android:name="com.google.android.youtube" />
        <package android:name="com.instagram.android" />
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.facebook.katana" />
        <package android:name="in.mohalla.video" />
        <package android:name="com.twitter.android" />
        <package android:name="com.twitter.android.lite" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.sharechat.android" />

        <!-- Installed app icons on Android 11+ (monitoring entity rows). -->
        <package android:name="com.instagram.android" />
        <package android:name="com.whatsapp" />
        <package android:name="com.android.chrome" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.facebook.katana" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.discord" />
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.gm" />
    </queries>

    <application
        android:name=".ShortsCapApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="ShortsCap"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.ShortsCap"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ShortsCap"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ShortsCap's OWN Accessibility Service (monitoring component, not UI
            automation). Declared so ShortsCap appears as its own service under
            Android Settings → Accessibility and the app can detect its real
            enabled/disabled state (AccessibilityServiceStatus).

            exported=true: on Android 12+ every service with an intent-filter
            must declare it, and the system AccessibilityManager needs to
            discover this service. Binding is still safe — only the system can
            bind, because BIND_ACCESSIBILITY_SERVICE is a signature-level
            permission no third-party app can hold.
        -->
        <service
            android:name=".accessibility.ShortsCapAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            Foreground Monitoring Service — keeps ShortsCap's monitoring
            process alive in the background after the user leaves the app or
            removes it from Recents (subject to Android/OEM restrictions).

            exported=false: only ShortsCap can start it. stopWithTask=false:
            swiping the app away must NOT intentionally stop monitoring.
            foregroundServiceType="specialUse" is the Android-appropriate
            type for continuous usage monitoring (it does not match
            dataSync/connectedDevice/etc.); on Android 14+ the subtype
            property below is mandatory for specialUse services.
        -->
        <service
            android:name=".monitoring.MonitoringService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuous_usage_monitoring" />
        </service>

        <!--
            Local VPN + DNS Filtering Engine (Web Blocking Engine). A
            VpnService that routes ONLY the DNS servers into the tunnel and
            drops DNS answers for domains in BlockedDomainRepository, so
            blocked websites cannot resolve/load while every other website
            and all other traffic continues normally. exported=false: only
            ShortsCap can start it (via VpnStateManager / the test activity).
            BIND_VPN_SERVICE is a signature-level permission only the system
            can hold, so binding is always safe.
        -->
        <service
            android:name=".web.vpn.LocalVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!--
            Minimal no-UI entry point that requests the one-time Android VPN
            consent and starts/stops the LocalVpnService. Exported so the
            functional verification can drive it via adb (am start with an
            ez extra start=true|false); it has no layout and shows only the
            system VPN consent dialog when permission is missing.
        -->
        <activity
            android:name=".web.vpn.VpnPermissionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>

</manifest>
