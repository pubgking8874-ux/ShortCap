<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Shown in Android Settings → Accessibility for ShortsCap's own service.
        The label is the app name so Android displays ShortsCap as its own
        accessibility service; the description explains the minimum-access,
        monitoring-only purpose shown to the user before they enable it.
    -->
    <string name="accessibility_service_label">ShortsCap</string>
    <string name="accessibility_service_description">ShortsCap uses this service to detect which app is currently open so it can monitor your short-video usage. It does not read, store, or share any content from other apps.</string>

    <!--
        Foreground Monitoring Service — persistent notification shown while
        the service keeps monitoring active in the background.
    -->
    <string name="monitoring_notification_channel">ShortsCap Monitoring</string>
    <string name="monitoring_notification_title">ShortsCap is monitoring</string>
    <string name="monitoring_notification_text">Usage monitoring is active in the background.</string>

    <!--
        Study Mode — one-shot notification posted when an active Study Mode
        session reaches its end time. Compact/banner style: it works whether
        ShortsCap is open or in the background and never launches the app on
        its own (only when the user taps the notification).
    -->
    <string name="study_session_notification_channel">Study Mode</string>
    <string name="study_session_ended_title">Study Session Ended</string>
    <string name="study_session_ended_text">Your study session has ended.</string>

    <!--
        Brain overlay — the small monitoring indicator shown above supported
        short-video apps (accessibility label read by TalkBack).
    -->
    <string name="brain_overlay_label">ShortsCap Brain monitoring indicator</string>
</resources>
