<?xml version="1.0" encoding="utf-8"?>
<!--
    Clean brain icon — used ONLY by the Brain appearance option inside
    Settings → Appearance → Shorts HUD (see BrainPreview in
    ShortsHudScreen.kt). A recognizable brain silhouette: two rounded
    hemispheres with a gentle center-top dip, five internal fold lines
    (sulci) and a tapered brain stem — drawn with the same thin round-cap
    stroke treatment as the ShortsCap icon family so it matches the existing
    style, stroke weight and size.

    The runtime Shorts HUD Brain mode plays the final brain videos instead
    of this icon; this drawable is never used for the floating overlay and
    never for the notification small icon (that stays `ic_brain`).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Brain silhouette (two hemispheres + tapered stem) -->
    <path
        android:pathData="M12,21
            C11.0,21 10.5,20.3 10.8,19.4
            C11.0,18.6 11.0,17.9 10.8,17.2
            C10.3,16.6 9.9,16.4 9.5,16.5
            C6.8,16.9 4.4,15.4 4.0,12.8
            C3.7,11.0 4.9,8.9 7.3,7.3
            C8.4,6.7 9.8,6.3 11.3,6.2
            C11.8,6.1 12.2,6.1 12.7,6.2
            C14.2,6.3 15.6,6.7 16.7,7.3
            C19.1,8.9 20.3,11.0 20.0,12.8
            C19.6,15.4 17.2,16.9 14.5,16.5
            C14.1,16.4 13.7,16.6 13.2,17.2
            C13.0,17.9 13.0,18.6 13.2,19.4
            C13.5,20.3 13.0,21 12,21 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Central top fold (longitudinal fissure) -->
    <path
        android:pathData="M12,6.4 C11.8,7.6 12.2,8.8 12,10"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Left hemisphere folds -->
    <path
        android:pathData="M6.6,8.9 C7.3,10.1 8.2,11.1 9.3,11.4"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M5.6,11.6 C6.5,12.6 7.7,13.3 9.0,13.4"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Right hemisphere folds (mirrored) -->
    <path
        android:pathData="M17.4,8.9 C16.7,10.1 15.8,11.1 14.7,11.4"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M18.4,11.6 C17.5,12.6 16.3,13.3 15.0,13.4"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
