<?xml version="1.0" encoding="utf-8"?>
<!--
    ShortsCap Accessibility Service configuration — MINIMUM capabilities only.

    The service is a monitoring component: it only needs TYPE_WINDOW_STATE_CHANGED
    events to know which app is currently in the foreground. It deliberately
    does NOT request:
      - window content retrieval (canRetrieveWindowContent = false)
      - touch exploration / gestures / key filtering / magnification
    → no UI automation, no reading or collecting content from other apps.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description" />
