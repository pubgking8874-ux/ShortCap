<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security config — DEBUG variant ONLY (Phase 19 hardening).

    Debug builds may talk to the local FastAPI dev server over plain HTTP
    (the emulator reaches the host via http://10.0.2.2:8000). This file is
    in src/debug, so the cleartext exception exists ONLY in debug APKs; the
    release/main variant (src/main/res/xml/network_security_config.xml)
    blocks all cleartext traffic.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
